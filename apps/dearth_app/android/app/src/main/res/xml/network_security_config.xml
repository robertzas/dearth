<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC §9.4: LAN displays may reach the Hub over plain http at a LAN
     address the family chooses at pairing time (and FreeKiosk on 127.0.0.1),
     so cleartext can't be limited to a fixed host list here. Remote access
     goes through the family's HTTPS domain. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
