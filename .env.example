# Copy to .env and adjust. See README.md → Hub configuration.

# Public HTTPS origin of the Hub (reverse proxy / tunnel). Optional: without
# it, Google sign-in uses the paste-back flow and Google Calendar changes are
# polled (README → Google Calendar). Set it only if this address really
# reaches the Hub: Google sign-in then redirects there.
# DEARTH_PUBLIC_URL=https://dearth.example.com

# Extra origins allowed to call the API (e.g. the LAN address of the Hub).
DEARTH_LAN_URLS=http://10.0.1.20:8080

# Admin password (otherwise one is generated and printed once in the logs).
DEARTH_ADMIN_PASSWORD=change-me

# Household time zone for first start (the app can change it later).
TZ=America/Denver

# Host folders to expose (read-only) for photo/music sources.
DEARTH_PHOTO_FOLDER=/mnt/nas/photos/frame
DEARTH_MUSIC_FOLDER=/mnt/nas/music/kids

# Contact string sent in the NWS User-Agent (their API asks for one).
DEARTH_CONTACT=you@example.com

# DEARTH_LOG_LEVEL=info
# DEARTH_HTTP_PORT=8080
