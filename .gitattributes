# Line endings: LF everywhere except Windows batch files.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Git LFS: every binary that has to live in the repo (images, fonts, wasm,
# audio/video, archives, native libraries). Text, generated Dart and JS stay
# in plain git.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
